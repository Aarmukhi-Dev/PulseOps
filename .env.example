# Copy this file to .env in the repository root.
# These values are for local development only.

POSTGRES_USER=pulseops
POSTGRES_PASSWORD=pulseops
POSTGRES_DB=pulseops
POSTGRES_PORT=5432

# Used by FastAPI, SQLAlchemy, and Alembic on the host.
# The hostname is localhost because Docker publishes PostgreSQL to this machine.
DATABASE_URL=postgresql+psycopg://pulseops:pulseops@localhost:5432/pulseops

# Optional for local development. In production, set this to Neon's direct URL
# and keep DATABASE_URL on Neon's pooled (-pooler) endpoint.
# MIGRATION_DATABASE_URL=postgresql+psycopg://pulseops:pulseops@localhost:5432/pulseops

# SQLAlchemy's local connection pool, in addition to Neon's server-side pooler.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Authentication. In production, set a random secret with at least 32 characters.
APP_ENV=development
# JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Per-process abuse limits. Use an edge/shared limiter for multi-instance production.
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Local development may manage services and run the worker. Production defaults both off.
SERVICE_MUTATIONS_ENABLED=true
MONITORING_WORKER_ENABLED=true
