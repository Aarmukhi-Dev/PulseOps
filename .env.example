# Copy this file to .env in the repository root.
# These values are for local development only.

POSTGRES_USER=pulseops
POSTGRES_PASSWORD=pulseops
POSTGRES_DB=pulseops
POSTGRES_PORT=5432

# Used by FastAPI, SQLAlchemy, and Alembic on the host.
# The hostname is localhost because Docker publishes PostgreSQL to this machine.
DATABASE_URL=postgresql+psycopg://pulseops:pulseops@localhost:5432/pulseops

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
